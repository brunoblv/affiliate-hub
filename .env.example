DATABASE_URL=postgresql://usuario:senha@localhost:5432/affiliate_hub
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# E-mails separados por vírgula que acessam /admin
ADMIN_EMAILS=

# Conector Shopee (API de afiliados)
SHOPEE_APP_ID=
SHOPEE_SECRET=

# Worker de preços (opcionais; valores padrão entre parênteses)
# SYNC_START_HOUR=3              hora do ciclo diário, America/Sao_Paulo
# SYNC_MAX_PRICE_CHANGE=0.4      variação acima disso vai para revisão
# SYNC_CONCURRENCY=2             coletas em paralelo
# SYNC_MAX_ATTEMPTS=3            tentativas por job

# E-mail dos alertas de preço (SMTP). Sem isso o alerta só aparece em /conta.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587 e senha de app em SMTP_PASS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Affiliate Hub <alertas@seudominio.com.br>"
# Endereço público do site, usado nos links do e-mail e no sitemap
NEXT_PUBLIC_SITE_URL=

# Conteúdo com Gemini (texto editorial dos produtos)
GEMINI_API_KEY=
# Modelo (padrão: gemini-2.5-flash). Modelos 3.x funcionam; o código já trata as diferenças.
GEMINI_MODEL=

# Onde ficam os arquivos das capas geradas (padrão: ./storage/creatives).
# Em produção, aponte para um volume persistente. O servidor precisa de fontes instaladas
# (ex.: fonts-liberation ou fonts-dejavu no Linux) para o texto das capas.
# CREATIVES_DIR=

# Distribuição Telegram: desabilitada por padrão. Só ofertas aprovadas/agendadas no admin.
# O bot precisa de permissão de publicação no grupo/canal e o destino do admin deve
# usar o ID numérico negativo do chat. Não colocar o token no cadastro de Comunidades.
DISTRIBUTION_ENABLED=false
TELEGRAM_BOT_TOKEN=
