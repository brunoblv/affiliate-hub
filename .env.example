DATABASE_URL=postgresql://usuario:senha@localhost:5432/affiliate_hub
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# E-mails separados por vírgula que acessam /admin
ADMIN_EMAILS=

# Conector Shopee (API de afiliados)
SHOPEE_APP_ID=
SHOPEE_SECRET=

# Conector Mercado Livre (API de catálogo, token client_credentials do próprio app).
# Criar o app em developers.mercadolivre.com.br; a "URI de redirect" é obrigatória no
# cadastro, mas não é usada (não há login de conta de usuário).
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=

# Conector AliExpress (Affiliate API do AliExpress Open Platform: openservice.aliexpress.com).
# App do tipo "Affiliates API"; o tracking ID (portals.aliexpress.com > Tracking ID) faz a API
# devolver o link de afiliado. Links curtos s.click.aliexpress.com/e/... também são aceitos no admin.
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=

# Worker de preços (opcionais; valores padrão entre parênteses)
# SYNC_START_HOUR=3              hora do ciclo diário, America/Sao_Paulo
# SYNC_MAX_PRICE_CHANGE=0.4      variação acima disso vai para revisão
# SYNC_CONCURRENCY=2             coletas em paralelo
# SYNC_MAX_ATTEMPTS=3            tentativas por job

# E-mail dos alertas de preço (SMTP). Sem isso o alerta só aparece em /conta.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587 e senha de app em SMTP_PASS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Affiliate Hub <alertas@seudominio.com.br>"
# Endereço público do site, usado nos links do e-mail e no sitemap
NEXT_PUBLIC_SITE_URL=

# Conteúdo com Gemini (texto editorial dos produtos)
GEMINI_API_KEY=
# Modelo (padrão: gemini-2.5-flash). Modelos 3.x funcionam; o código já trata as diferenças.
GEMINI_MODEL=

# Onde ficam os arquivos das capas geradas (padrão: ./storage/creatives).
# Em produção, aponte para um volume persistente. O servidor precisa de fontes instaladas
# (ex.: fonts-liberation ou fonts-dejavu no Linux) para o texto das capas.
# CREATIVES_DIR=

# Distribuição Telegram: desabilitada por padrão. Só ofertas aprovadas/agendadas no admin.
# O bot precisa de permissão de publicação no grupo/canal e o destino do admin deve
# usar o ID numérico negativo do chat. Não colocar o token no cadastro de Comunidades.
DISTRIBUTION_ENABLED=false
TELEGRAM_BOT_TOKEN=

# Push: gerar uma vez com npx web-push generate-vapid-keys --json.
# Manter a chave privada apenas no servidor e no worker.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# VAPID_SUBJECT: mailto:email-de-contato@seudominio.com.br

# Páginas institucionais e LGPD (/contato, /politica-de-privacidade, /termos-de-uso).
# Sem valor, as páginas exibem "[definir ...]" — preencher antes de publicar.
OPERATOR_NAME=
# CPF ou CNPJ do responsável pelo site
OPERATOR_DOCUMENT=
# Cidade/UF ou endereço
OPERATOR_ADDRESS=
CONTACT_EMAIL=
# Encarregado de dados (DPO). Se vazio, usa OPERATOR_NAME e CONTACT_EMAIL.
DPO_NAME=
DPO_EMAIL=

# AdSense: ID de publisher (ex.: pub-1234567890123456). Com ele, /ads.txt passa a responder.
ADSENSE_PUBLISHER_ID=

# Blogs nos subdomínios (ex.: meunovolar.capibusca.com.br). Padrão: o host de NEXT_PUBLIC_SITE_URL.
# Em dev, BLOG_BASE_DOMAIN=localhost permite abrir http://meunovolar.localhost:3000.
BLOG_BASE_DOMAIN=
# Imagens dos blogs (padrão: ./storage/media). Em produção, volume persistente.
# MEDIA_DIR=
# Capas e imagens geradas por IA nos blogs (OpenAI Images). Sem chave, a capa é composta localmente.
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1.5
# OPENAI_IMAGE_QUALITY=medium
# Gemini dos blogs: modelo preferido para artigos longos (opcional).
# GEMINI_MODEL_ARTICLE=
# Só para scripts/migrate-meunovolar.ts (migração única do blog antigo).
# MEUNOVOLAR_DATABASE_URL=
# MEUNOVOLAR_MEDIA_ROOT=
