generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Auth.js: @auth/prisma-adapter resolve os models pelo nome do client gerado
// (user/account), então ficam em inglês. Sessão é JWT, sem model Session.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  accounts    Account[]
  favorites   Favorite[]
  priceAlerts PriceAlert[]
  pushSubscriptions PushSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// Produtos ainda vivem em lib/data.ts, então referenciamos por slug.
model Favorite {
  id           String   @id @default(cuid())
  userId       String
  productId    String
  savedAtCents Int?
  createdAt    DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("favorites")
}

model PriceAlert {
  id                 String    @id @default(cuid())
  userId             String
  productId          String
  /// Nulos nos alertas legados: exigem confirmação explícita antes de notificar.
  variantId          String?
  itemCondition      ItemCondition?
  priceCondition     String?
  contextKey         String?
  revision           Int       @default(0)
  deliveryStatus     AlertDeliveryStatus @default(IDLE)
  deliveryToken      String?
  deliveryStartedAt  DateTime?
  nextAttemptAt      DateTime?
  attemptCount       Int       @default(0)
  targetCents        Int
  /// Quando o aviso desta passagem pela meta foi enviado. Nulo = ainda não avisado
  /// (ou o preço voltou a subir e o alerta foi rearmado).
  notifiedAt         DateTime?
  notifiedPriceCents Int?
  createdAt          DateTime  @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  deliveries PriceAlertDelivery[]
  pushDeliveries PushDelivery[]

  @@unique([userId, productId, contextKey])
  @@index([variantId])
  @@map("price_alerts")
}

enum AlertDeliveryStatus {
  IDLE
  SENDING
  SENT
  FAILED
  UNCERTAIN
}

model PushSubscription {
  id String @id @default(cuid())
  userId String
  endpoint String @unique
  p256dh String
  auth String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries PushDelivery[]
  @@index([userId])
  @@map("push_subscriptions")
}

// Estado independente do SMTP, por alerta e dispositivo.
model PushDelivery {
  id String @id @default(cuid())
  alertId String
  subscriptionId String
  contextKey String
  targetCents Int
  status AlertDeliveryStatus @default(IDLE)
  token String?
  startedAt DateTime?
  nextAttemptAt DateTime?
  attemptCount Int @default(0)
  errorCode String?
  alert PriceAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  subscription PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  @@unique([alertId, subscriptionId])
  @@index([status, startedAt])
  @@map("push_deliveries")
}

model PriceAlertDelivery {
  id           String @id @default(cuid())
  alertId      String
  revision     Int
  status       AlertDeliveryStatus
  priceCents   Int
  targetCents  Int
  contextKey   String
  errorCode    String?
  startedAt    DateTime @default(now())
  finishedAt   DateTime?

  alert PriceAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId, startedAt])
  @@index([status, startedAt])
  @@map("price_alert_deliveries")
}

// ---------------------------------------------------------------------------
// Catálogo: produto canônico -> variação -> oferta (por loja/vendedor)
// Preço sempre em centavos inteiros.
// ---------------------------------------------------------------------------

enum CollectionMethod {
  API
  SCRAPER
  MANUAL
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Availability {
  IN_STOCK
  OUT_OF_STOCK
  UNKNOWN
}

enum OfferStatus {
  ACTIVE
  STALE
  ERROR
}

enum ShippingKind {
  FREE
  PAID
  CONDITIONAL
  UNKNOWN
}

enum ItemCondition {
  NEW
  USED
}

model Niche {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  icon        String?
  color       String?
  position    Int     @default(0)
  active      Boolean @default(true)

  categories Category[]
  products   ProductNiche[]
  communities Community[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("niches")
}

enum CommunityPlatform {
  WHATSAPP
  TELEGRAM
}

enum CommunityKind {
  GROUP
  CHANNEL
}

model Community {
  id String @id @default(cuid())
  nicheId String
  name String
  platform CommunityPlatform
  kind CommunityKind
  inviteUrl String
  publicationId String?
  active Boolean @default(false)
  position Int @default(0)
  niche Niche @relation(fields: [nicheId], references: [id], onDelete: Restrict)
  clicks CommunityClick[]
  publications Publication[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nicheId, active, position])
  @@map("communities")
}

/// Clique de entrada, nunca confirmação de adesão. Nicho preservado no momento do clique.
model CommunityClick {
  id String @id @default(cuid())
  communityId String
  nicheId String
  source String?
  createdAt DateTime @default(now())
  community Community @relation(fields: [communityId], references: [id], onDelete: Restrict)

  @@index([communityId, createdAt])
  @@index([nicheId, createdAt])
  @@index([createdAt])
  @@map("community_clicks")
}

model Category {
  id       String  @id @default(cuid())
  slug     String  @unique
  name     String
  nicheId  String
  parentId String?
  position Int     @default(0)

  niche    Niche      @relation(fields: [nicheId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@map("categories")
}

model Store {
  id        String           @id @default(cuid())
  slug      String           @unique
  name      String
  method    CollectionMethod @default(MANUAL)
  /// Chave do conector em lib/connectors (ex.: "shopee"). Nulo = só ofertas manuais.
  connector String?
  active    Boolean          @default(true)

  offers Offer[]

  createdAt DateTime @default(now())

  @@map("stores")
}

model Product {
  id         String        @id @default(cuid())
  slug       String        @unique
  name       String
  brand      String?
  model      String?
  gtin       String?
  summary    String?
  specs      Json?
  /// nome + marca + modelo + gtin, sem acento e em minúsculas (busca RF-10).
  searchText String        @default("")
  status     ProductStatus @default(DRAFT)
  categoryId String?
  /// Última busca de correspondência no Mercado Livre (null = ainda não procurado).
  mlMatchCheckedAt DateTime?

  category    Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  niches      ProductNiche[]
  variants    ProductVariant[]
  images      ProductImage[]
  favorites   Favorite[]
  priceAlerts PriceAlert[]
  content     ProductContent?
  creatives   Creative[]
  matchSuggestions MatchSuggestion[]
  postItems        PostProduct[]
  larsmartImages   LarSmartImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("products")
}

model ProductNiche {
  productId String
  nicheId   String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  niche   Niche   @relation(fields: [nicheId], references: [id], onDelete: Cascade)

  @@id([productId, nicheId])
  @@map("product_niches")
}

/// Todo produto tem ao menos uma variação (a padrão), mesmo sem opções.
model ProductVariant {
  id         String  @id @default(cuid())
  productId  String
  label      String
  attributes Json?
  isDefault  Boolean @default(false)

  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  offers  Offer[]
  images  ProductImage[]
  priceAlerts PriceAlert[]

  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id         String    @id @default(cuid())
  productId  String
  variantId  String?
  url        String
  alt        String?
  position   Int       @default(0)
  isCover    Boolean   @default(false)
  /// De onde veio a foto (ex.: "manual", "shopee").
  source     String?
  /// Última checagem da URL e resultado. Foto quebrada some do site sem quebrar a página.
  verifiedAt DateTime?
  broken     Boolean   @default(false)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@map("product_images")
}

model Offer {
  id                  String           @id @default(cuid())
  variantId           String
  storeId             String
  sellerName          String
  externalListingId   String?
  externalVariantId   String?
  /// Vendedor/loja no marketplace (ex.: shopId da Shopee).
  externalSellerId    String?
  originalUrl         String?
  priceCents          Int?
  previousPriceCents  Int?
  installments        Int?
  /// Total a prazo (parcelado), quando difere do à vista em priceCents.
  installmentPriceCents Int?
  /// Condição do preço à vista (ex.: "Pix", "NuPay").
  priceCondition      String?
  shippingKind        ShippingKind     @default(UNKNOWN)
  shippingCents       Int?
  condition           ItemCondition    @default(NEW)
  availability        Availability     @default(UNKNOWN)
  method              CollectionMethod @default(MANUAL)
  status              OfferStatus      @default(ACTIVE)
  active              Boolean          @default(true)
  /// Última coleta bem-sucedida do preço.
  priceCheckedAt      DateTime?
  /// Última tentativa, com sucesso ou não.
  lastAttemptAt       DateTime?
  lastError           String?
  consecutiveFailures Int              @default(0)
  /// Valor coletado que destoa muito do anterior: fica aqui até um admin aprovar.
  needsReview         Boolean          @default(false)
  reviewReason        String?
  pendingPriceCents   Int?

  variant  ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  store    Store           @relation(fields: [storeId], references: [id])
  links    AffiliateLink[]
  prices   PricePoint[]
  syncJobs SyncJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, externalListingId, variantId])
  @@index([variantId])
  @@map("offers")
}

/// Único lugar de onde sai URL pública de compra. Nunca cair para originalUrl.
model AffiliateLink {
  id        String  @id @default(cuid())
  offerId   String
  url       String
  label     String?
  shortCode String  @unique
  active    Boolean @default(true)

  offer  Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  clicks Click[]

  createdAt DateTime @default(now())

  @@index([offerId])
  @@map("affiliate_links")
}

/// Clique no botão de uma loja. Não prova compra nem comissão (RF-12).
model Click {
  id        String   @id @default(cuid())
  linkId    String?
  offerId   String?
  productId String?
  storeId   String?
  /// Caminho da página de origem (ex.: /produto/x), quando conhecido.
  source    String?
  createdAt DateTime @default(now())

  link AffiliateLink? @relation(fields: [linkId], references: [id], onDelete: SetNull)

  @@index([offerId, createdAt])
  @@index([productId, createdAt])
  @@index([createdAt])
  @@map("clicks")
}

model PricePoint {
  id           String           @id @default(cuid())
  offerId      String
  /// Identidade comparável no momento da observação. Pontos legados ficam null.
  variantId    String?
  itemCondition ItemCondition?
  priceCents   Int
  /// Condições observadas no momento da coleta; null significa que a fonte não informou.
  priceCondition String?
  installmentPriceCents Int?
  shippingKind ShippingKind?
  shippingCents Int?
  /// Impede que a retomada de um job grave duas observações para a mesma coleta.
  syncJobId String? @unique
  availability Availability     @default(UNKNOWN)
  source       CollectionMethod
  observedAt   DateTime         @default(now())

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId, observedAt])
  @@map("price_points")
}

enum MatchStatus {
  PENDING
  ACCEPTED
  AUTO
  REJECTED
}

/// Candidato do Mercado Livre (produto de catálogo) para um produto importado da Shopee.
/// Alta confiança vira oferta sozinha (AUTO); o resto espera a escolha do admin (PENDING).
model MatchSuggestion {
  id         String      @id @default(cuid())
  productId  String
  catalogId  String
  name       String
  imageUrl   String?
  priceCents Int?
  score      Int
  reasons    String[]
  status     MatchStatus @default(PENDING)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([productId, catalogId])
  @@index([status, score])
  @@map("match_suggestions")
}

enum SyncJobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

enum SyncReason {
  SCHEDULED
  MANUAL
  RETRY
}

/// Fila persistente de coleta de preço. Um job em andamento por oferta; lease
/// (lockedUntil) permite retomar o trabalho de um worker que caiu.
model SyncJob {
  id           String        @id @default(cuid())
  offerId      String
  status       SyncJobStatus @default(QUEUED)
  reason       SyncReason    @default(SCHEDULED)
  scheduledFor DateTime      @default(now())
  attempts     Int           @default(0)
  lockedUntil  DateTime?
  startedAt    DateTime?
  finishedAt   DateTime?
  /// Resultado resumido: preço coletado, mudança, revisão pendente...
  result       Json?
  error        String?

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([status, scheduledFor])
  @@index([offerId, status])
  @@map("sync_jobs")
}

model WorkerHeartbeat {
  id         String   @id
  startedAt  DateTime
  lastSeenAt DateTime
  info       Json?

  @@map("worker_heartbeats")
}

enum ContentStatus {
  PENDING
  GENERATING
  DRAFT
  REVIEWED
  PUBLISHED
  FAILED
}

/// Conteúdo editorial do produto (RF-13). Preço nunca entra aqui: é bloco dinâmico do banco.
model ProductContent {
  id                  String        @id @default(cuid())
  productId           String        @unique
  status              ContentStatus @default(PENDING)
  /// Material de referência colado pelo admin (ficha do fabricante, descrição da loja).
  /// É a única fonte de fatos do texto gerado.
  sourceMaterial      String?
  /// Seções do texto (título, resumo, descrição, benefícios, público, uso, cuidados, FAQ, meta).
  sections            Json?
  /// Seções editadas à mão: a regeneração automática não as sobrescreve.
  protectedKeys       String[]
  /// Problemas achados na validação do texto (bloqueiam a publicação).
  issues              Json?
  /// Pendências de dados (ex.: "modo de uso sem fonte").
  pendencies          Json?
  model               String?
  promptVersion       String?
  /// Exatamente o que foi enviado ao modelo.
  inputSnapshot       Json?
  inputTokens         Int?
  outputTokens        Int?
  error               String?
  generationStartedAt DateTime?
  generatedAt         DateTime?
  reviewedAt          DateTime?
  publishedAt         DateTime?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("product_contents")
}

enum CreativeStatus {
  PENDING_APPROVAL
  APPROVED
  PUBLISHED
  INVALIDATED
}

/// Capa/criativo gerado (RF-15). O arquivo fica em disco; aqui ficam os dados de rastreio.
model Creative {
  id                String         @id @default(cuid())
  productId         String
  /// Formato: share (1200x630), feed (1080x1350), story (1080x1920), square (1080x1080).
  format            String
  template          String
  templateVersion   Int
  width             Int
  height            Int
  /// Caminho relativo dentro do diretório de criativos.
  file              String
  status            CreativeStatus @default(PENDING_APPROVAL)
  withPrice         Boolean        @default(false)
  /// Preço mostrado na imagem e quando foi observado (só quando withPrice).
  priceCents        Int?
  priceObservedAt   DateTime?
  invalidatedReason String?
  approvedAt        DateTime?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  publications Publication[]

  createdAt DateTime @default(now())

  @@index([productId, status])
  @@map("creatives")
}

enum PublicationStatus {
  DRAFT
  QUEUED
  SENDING
  SENT
  FAILED
  UNCERTAIN
  CANCELED
}

/// IDs de catálogo e dados aprovados são snapshots preservados mesmo após retirada do produto.
model Publication {
  id String @id @default(cuid())
  communityId String
  nicheId String
  productId String
  offerId String
  linkId String
  creativeId String?
  contentType String @default("oferta_individual")
  title String
  text String
  targetId String
  priceCents Int
  priceObservedAt DateTime
  /// Fingerprint dos dados comerciais e destino que o admin aprovou.
  fingerprint String
  status PublicationStatus @default(DRAFT)
  scheduledFor DateTime?
  startedAt DateTime?
  sentAt DateTime?
  externalId String?
  error String?
  attemptCount Int @default(0)
  community Community @relation(fields: [communityId], references: [id], onDelete: Restrict)
  creative Creative? @relation(fields: [creativeId], references: [id], onDelete: Restrict)
  attempts PublicationAttempt[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, scheduledFor])
  @@index([targetId, scheduledFor])
  @@index([productId, createdAt])
  @@map("publications")
}

model PublicationAttempt {
  id String @id @default(cuid())
  publicationId String
  status PublicationStatus
  detail String?
  externalId String?
  createdAt DateTime @default(now())
  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Restrict)

  @@index([publicationId, createdAt])
  @@map("publication_attempts")
}

enum MetricKind {
  SEARCH
  PRODUCT_VIEW
}

/// Eventos de páginas visíveis, sem identificação do visitante. IDs do catálogo são snapshots.
model MetricEvent {
  id String @id
  kind MetricKind
  productId String?
  nicheId String?
  term String?
  resultCount Int?
  createdAt DateTime @default(now())

  @@index([createdAt, kind])
  @@index([kind, term, createdAt])
  @@index([productId, createdAt])
  @@map("metric_events")
}

// Token renovável de rede social (ex.: Threads, 60 dias). Valor cifrado com AUTH_SECRET.
model SocialToken {
  id          String   @id
  ciphertext  String
  expiresAt   DateTime
  refreshedAt DateTime

  @@map("social_tokens")
}

// ---------------------------------------------------------------------------
// Blogs editoriais (ex.: meunovolar.capibusca.com.br). Cada blog é servido no
// subdomínio `<subdomain>.<BLOG_BASE_DOMAIN>`; os cards de produto dos posts
// apontam para o catálogo do comparador.
// ---------------------------------------------------------------------------

enum PostKind {
  /// Artigo editorial (dicas, jornada). Único tipo indexado e listado no blog.
  EDITORIAL
  /// Ficha de um produto só.
  PRODUCT
  /// Roundup com vários produtos.
  LIST
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

/// Linha editorial do post. Cada uma tem prompts próprios (content/blogs/<sub>/prompts)
/// e cada blog escolhe as suas em Blog.categories.
enum EditorialCategory {
  HOME_TIPS
  APARTMENT_JOURNEY
  SPIRITUAL_JOURNEY
  SPIRITUAL_REFLECTION
  SPIRITUALITY_GUIDE
}

model Blog {
  id         String              @id @default(cuid())
  /// Subdomínio sem o domínio base (ex.: "meunovolar"). Também é a pasta em content/blogs/.
  subdomain  String              @unique
  name       String
  tagline    String?
  /// Texto da página /sobre do blog (markdown).
  about      String?             @db.Text
  /// Autor exibido nos posts sem autor próprio.
  authorName String?
  categories EditorialCategory[]
  active     Boolean             @default(true)

  posts        Post[]
  journeyNotes JourneyNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("blogs")
}

model Post {
  id       String             @id @default(cuid())
  blogId   String
  kind     PostKind
  category EditorialCategory?
  title    String
  slug     String
  summary  String?

  /// Markdown. Imagens via ![alt](url), card de produto via [produto:slug] e botão
  /// de afiliado via [cta:url] (cada shortcode em linha própria).
  body String @db.Text

  coverId String?
  audioId String?

  seoTitle        String?
  metaDescription String?

  status      PostStatus @default(DRAFT)
  publishedAt DateTime?

  /// Caixa fixa de aviso no topo (ex.: não misturar produtos de limpeza).
  safetyNotice Boolean @default(false)
  authorName   String?

  /// Pauta usada pelo LarSmart para gerar o post (permite regenerar ou trocar produto).
  larsmartBrief Json?

  blog           Blog            @relation(fields: [blogId], references: [id], onDelete: Cascade)
  cover          Media?          @relation("PostCover", fields: [coverId], references: [id], onDelete: SetNull)
  audio          Media?          @relation("PostAudio", fields: [audioId], references: [id], onDelete: SetNull)
  products       PostProduct[]
  media          PostMedia[]
  larsmartImages LarSmartImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([blogId, slug])
  @@index([blogId, status, publishedAt])
  @@index([blogId, kind, category])
  @@map("posts")
}

/// Produto citado no post (shortcodes [produto:slug]), na ordem do texto.
model PostProduct {
  id        String  @id @default(cuid())
  postId    String
  productId String
  position  Int     @default(0)
  label     String?
  note      String? @db.Text

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([postId, productId])
  @@index([postId, position])
  @@map("post_products")
}

/// Registro livre da jornada pessoal: contexto real para a IA não inventar detalhes.
model JourneyNote {
  id       String             @id @default(cuid())
  blogId   String
  category EditorialCategory?
  text     String             @db.Text

  blog Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([blogId, category])
  @@map("journey_notes")
}

/// Biblioteca de mídia dos blogs. Arquivos ficam em MEDIA_DIR e são servidos por /midia.
model Media {
  id           String  @id @default(cuid())
  /// URL pública (ex.: /midia/2026/10/sofa-abc123.webp).
  url          String  @unique
  /// Caminho relativo a MEDIA_DIR.
  path         String
  originalName String
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  alt          String?

  coverOf        Post[]          @relation("PostCover")
  audioOf        Post[]          @relation("PostAudio")
  usedIn         PostMedia[]
  larsmartImages LarSmartImage[]

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("media")
}

/// Imagens embutidas no corpo de cada post: avisa antes de excluir mídia em uso.
model PostMedia {
  postId  String
  mediaId String

  post  Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([postId, mediaId])
  @@map("post_media")
}

enum LarSmartImageKind {
  COVER
  PRODUCT
}

/// Imagem gerada pelo LarSmart: guarda o prompt e as legendas para o Pinterest.
model LarSmartImage {
  id        String            @id @default(cuid())
  postId    String
  mediaId   String
  /// null na capa; preenchido na imagem de ambiente de um produto.
  productId String?
  kind      LarSmartImageKind
  prompt    String            @db.Text

  pinterestTitle       String?
  pinterestDescription String? @db.Text

  post    Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  media   Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([postId, productId, kind])
  @@map("larsmart_images")
}
