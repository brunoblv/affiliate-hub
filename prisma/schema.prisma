// Affiliate Hub v2 — schema enxuto
// Blog (CMS) + catálogo de produtos + fila de distribuição.
// Ver docs/hub/especificacao-affiliate-hub-v2.md

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Admin (NextAuth) — nomes em inglês de propósito: @auth/prisma-adapter
// resolve os models pelo nome do client gerado (prisma.user/.account/.session),
// então não pode ser traduzido para Usuario/Conta/Sessao como no restante do
// schema, sob pena de o adapter quebrar em silêncio.
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  EDITOR
  VIEWER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  passwordHash  String?
  role          UserRole  @default(EDITOR)
  emailVerified DateTime?
  image         String?

  accounts Account[]
  sessions Session[]
  posts    Post[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// ---------------------------------------------------------------------------
// CONTEÚDO — blog editável pelo CMS
// ---------------------------------------------------------------------------

enum TipoPost {
  JORNADA // editorial: "Como escolhemos o sofá"
  PRODUTO // página de um produto só
  LISTA // roundup com vários produtos
}

/// Sub-classificação de posts tipo JORNADA, usada pela geração via IA
/// (tema + prompt distintos por categoria). Nula em posts antigos/manuais.
enum CategoriaEditorial {
  DICAS_CASA // organização, manutenção e decoração da casa
  JORNADA_APARTAMENTO // jornada pessoal de compra/mudança de apartamento
}

enum StatusPost {
  RASCUNHO
  PUBLICADO
}

model Post {
  id                 String              @id @default(cuid())
  tipo               TipoPost
  categoriaEditorial CategoriaEditorial?
  titulo             String
  slug               String              @unique
  resumo             String?

  /// Markdown. Imagens no meio do texto via ![alt](url), cards de produto via
  /// [produto:slug] e botão de lista/afiliado via [cta:url] (linha própria).
  corpo String @db.Text

  capaId String?
  capa   Midia?  @relation("CapaDoPost", fields: [capaId], references: [id], onDelete: SetNull)

  /// Narração TTS do artigo (WAV gerado sob demanda no admin).
  audioId String?
  audio   Midia?  @relation("AudioDoPost", fields: [audioId], references: [id], onDelete: SetNull)

  seoTitulo     String?
  metaDescricao String?

  status      StatusPost @default(RASCUNHO)
  publicadoEm DateTime?

  /// Exibe caixa de aviso fixa no topo do corpo (ex.: não misturar produtos de
  /// limpeza) — marcado manualmente pelo editor em posts sobre químicos/limpeza.
  avisoSeguranca Boolean @default(false)

  /// Site/grupos pra onde este post é distribuído (LISTA e JORNADA). Jornada
  /// vai só para Facebook (página) e Instagram do destino, às 12h nos dias vazios.
  destino Destino @default(MEU_NOVO_LAR)

  /// Pauta sintética (PautaListaCasa) usada pelo LarSmart pra gerar este post —
  /// null em posts que não vieram do LarSmart. Guardada pra permitir regenerar
  /// o artigo ou trocar um produto sem precisar reinterpretar o tema.
  larsmartPauta Json?

  autorId String?
  autor   User?   @relation(fields: [autorId], references: [id], onDelete: SetNull)

  produtos        ItemDePost[]
  midias          MidiaEmPost[]
  imagensLarSmart ImagemLarSmart[]
  publicacoes     Publicacao[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([status, publicadoEm])
  @@index([tipo])
  @@index([tipo, categoriaEditorial])
  @@map("posts")
}

/// Bloco de texto livre sobre a jornada pessoal (compra/mudança de
/// apartamento) do usuário — vira contexto real pro Gemini usar ao gerar
/// artigos da categoria JORNADA_APARTAMENTO, em vez de inventar detalhe.
model NotaJornada {
  id       String   @id @default(cuid())
  texto    String   @db.Text
  criadoEm DateTime @default(now())

  @@map("notas_jornada")
}

/// Produto exibido dentro de um post (PRODUTO ou LISTA), na ordem do texto.
model ItemDePost {
  id        String  @id @default(cuid())
  postId    String
  produtoId String
  ordem     Int     @default(0)
  /// Ex.: "1. Sofá retrátil 3 lugares"
  rotulo    String?
  /// Por que esse produto, em 1-2 frases suas.
  nota      String? @db.Text

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@unique([postId, produtoId])
  @@index([postId, ordem])
  @@map("itens_de_post")
}

// ---------------------------------------------------------------------------
// MÍDIA — biblioteca de imagens do CMS
// ---------------------------------------------------------------------------

model Midia {
  id           String  @id @default(cuid())
  /// URL pública servida pelo site (ex.: /midia/2026/08/sofa-abc123.webp)
  url          String  @unique
  /// Caminho no disco/bucket, relativo a MEDIA_ROOT.
  caminho      String
  nomeOriginal String
  mimeType     String
  tamanhoBytes Int
  largura      Int?
  altura       Int?
  /// Texto alternativo — obrigatório para acessibilidade e SEO.
  alt          String?

  capaDe          Post[]           @relation("CapaDoPost")
  audioDe         Post[]           @relation("AudioDoPost")
  usosEmPosts     MidiaEmPost[]
  imagensLarSmart ImagemLarSmart[]

  criadoEm DateTime @default(now())

  @@index([criadoEm])
  @@map("midias")
}

/// Rastreia quais imagens estão embutidas no corpo de cada post.
/// Serve para avisar antes de excluir uma mídia ainda em uso.
model MidiaEmPost {
  postId  String
  midiaId String

  post  Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  midia Midia @relation(fields: [midiaId], references: [id], onDelete: Cascade)

  @@id([postId, midiaId])
  @@map("midias_em_posts")
}

/// Imagem gerada pelo LarSmart (capa ou ambiente por produto) — guarda o
/// vínculo produto↔imagem, o prompt usado (permite depurar/regenerar) e as
/// legendas prontas para exportação manual ao Pinterest. `Midia.alt` segue
/// sendo o texto alternativo; esta tabela não duplica isso.
enum TipoImagemLarSmart {
  CAPA
  PRODUTO
}

model ImagemLarSmart {
  id        String             @id @default(cuid())
  postId    String
  midiaId   String
  /// null para a capa; preenchido para a imagem de ambiente de um produto.
  produtoId String?
  tipo      TipoImagemLarSmart

  /// Prompt de imagem enviado à API — guardado para depuração/regeneração.
  prompt String @db.Text

  pinterestTitulo    String?
  pinterestDescricao String? @db.Text

  post    Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  midia   Midia    @relation(fields: [midiaId], references: [id], onDelete: Cascade)
  produto Produto? @relation(fields: [produtoId], references: [id], onDelete: SetNull)

  criadoEm DateTime @default(now())

  @@unique([postId, produtoId, tipo])
  @@map("imagens_larsmart")
}

// ---------------------------------------------------------------------------
// CATÁLOGO
// ---------------------------------------------------------------------------

enum Plataforma {
  MERCADO_LIVRE
  AMAZON
  SHOPEE
  TIKTOK_SHOP
}

/// Onde o produto é divulgado (site + grupos) — independente da Plataforma
/// (a loja de origem). Um produto do Mercado Livre pode ser de Umbanda, por
/// exemplo: a Plataforma é de onde ele foi comprado, o Destino é pra quem.
enum Destino {
  MEU_NOVO_LAR
  TIKTOK_SHOP
  UMBANDA
}

/// Nicho/tema do produto p/ categorização de catálogo — independente de
/// Destino (que é canal/público de divulgação, não assunto do produto).
/// Os valores abaixo de CASA até ELETRODOMESTICOS são o catálogo "de casa" do
/// Meu Novo Lar — ver HOME_CATEGORIAS em lib/produtos.ts, usado para filtrar
/// o catálogo público. As demais (BELEZA, ELETRONICOS, MODA,
/// UMBANDA_RELIGIAO, PET) seguem existindo só por causa de produtos antigos
/// já cadastrados com essas categorias; novos cadastros não devem usá-las.
enum Categoria {
  CASA
  ORGANIZACAO
  COZINHA
  BANHEIRO
  LAVANDERIA
  LIMPEZA
  DECORACAO
  ILUMINACAO
  MOVEIS
  FERRAMENTAS
  JARDIM
  ELETRODOMESTICOS
  BELEZA
  CASA_DECORACAO
  ELETRONICOS
  MODA
  UMBANDA_RELIGIAO
  PET
  OUTRA
}

model Produto {
  id         String     @id @default(cuid())
  plataforma Plataforma
  /// ID na plataforma de origem (ex.: MLB1234567890)
  idExterno  String
  slug       String     @unique
  /// Site/grupos onde é divulgado — ver enum Destino.
  destino    Destino    @default(MEU_NOVO_LAR)
  /// Nicho/tema do produto — ver enum Categoria.
  categoria  Categoria  @default(OUTRA)

  nome          String
  descricao     String? @db.Text
  /// string[] — até 6 URLs de imagem vindas da API da plataforma.
  imagens       Json    @default("[]")
  /// Texto curto opcional de curadoria ("por que selecionamos este produto"),
  /// preenchido manualmente pelo editor — exibido no catálogo quando presente.
  notaEditorial String? @db.Text

  precoAtual    Decimal  @db.Decimal(12, 2)
  precoOriginal Decimal? @db.Decimal(12, 2)
  moeda         String   @default("BRL")

  /// Link de afiliado. Nos posts sociais de produto sai direto; no site, via /go.
  linkAfiliado String
  /// Código do redirecionador rastreado: /go/:codigoCurto
  codigoCurto  String @unique

  /// Resposta íntegra da API no último sync — só para depuração.
  dadosBrutos Json?

  ativo          Boolean   @default(true)
  sincronizadoEm DateTime?

  /// Entra na curadoria da landing mesmo sem atingir o desconto mínimo.
  destaqueVitrine Boolean @default(false)

  itens            ItemDePost[]
  publicacoes      Publicacao[]
  cliques          Clique[]
  linksEtiquetados LinkAfiliadoEtiquetado[]
  precos           HistoricoPreco[]
  itensLanding     LandingProduto[]
  landingsHero     LandingDiaria[]          @relation("HeroDaLanding")
  imagensLarSmart  ImagemLarSmart[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([plataforma, idExterno])
  @@index([ativo])
  @@index([destino])
  @@index([categoria])
  @@map("produtos")
}

/// Short link da Shopee com subIds (tipo de post + canal). Cache pra não
/// chamar generateShortLink a cada clique/agendamento.
model LinkAfiliadoEtiquetado {
  id        String   @id @default(cuid())
  produtoId String
  /// subIds unidos por "|", ex.: "lista|facebook-achadinhos"
  chave     String
  url       String
  criadoEm  DateTime @default(now())

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@unique([produtoId, chave])
  @@index([produtoId])
  @@map("links_afiliado_etiquetados")
}

/// Só para mostrar "de R$ X por R$ Y" com honestidade e detectar produto fora do ar.
model HistoricoPreco {
  id           String   @id @default(cuid())
  produtoId    String
  preco        Decimal  @db.Decimal(12, 2)
  registradoEm DateTime @default(now())

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@index([produtoId, registradoEm])
  @@map("historico_precos")
}

// ---------------------------------------------------------------------------
// DISTRIBUIÇÃO
// ---------------------------------------------------------------------------

enum Rede {
  FACEBOOK_PAGE
  FACEBOOK_GROUP
  INSTAGRAM
  TELEGRAM
  WHATSAPP
}

model Canal {
  id        String  @id @default(cuid())
  nome      String
  rede      Rede
  /// Site/grupos que este canal atende — ver enum Destino.
  destino   Destino @default(MEU_NOVO_LAR)
  /// page_id (Facebook page), group_id (Facebook group), ig_user_id (Instagram),
  /// chat_id (Telegram) ou JID do grupo (WhatsApp/Baileys).
  idExterno String
  ativo     Boolean @default(true)

  /// Gerado da janela 09:00–21:00 (Brasília) a cada intervaloMinimoMin. O scheduler não lê este campo.
  horarios Json @default("[]")

  /// Minutos mínimos entre duas publicações neste canal.
  intervaloMinimoMin Int @default(10)
  /// Máximo de publicações por dia neste canal.
  tetoDiario         Int @default(73)
  /// Dias antes de o mesmo produto poder repetir neste canal.
  cooldownDias       Int @default(30)

  /// Máximo de posts OFERTA_INDIVIDUAL por dia — só vale para FACEBOOK_PAGE
  /// (ver docs/hub/regras-postagem-facebook.md, regra 1). Independente do
  /// tetoDiario geral, que segue valendo para os demais content types.
  tetoOfertaIndividualDiario Int @default(3)

  /// Teste A/B (regra 4): true publica sem o link na legenda/preview e cria
  /// um comentário automático com o link logo após a publicação. Vale só
  /// para FACEBOOK_PAGE.
  linkEmComentario Boolean @default(false)

  publicacoes Publicacao[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([rede, idExterno])
  @@index([ativo])
  @@index([destino])
  @@map("canais")
}

enum StatusPublicacao {
  PENDENTE
  PUBLICANDO
  PUBLICADA
  FALHOU
  CANCELADA
}

/// Classificação do post pra regras de cadência/mix do Facebook — ver
/// docs/hub/regras-postagem-facebook.md. Calculada uma vez no agendamento
/// (não muda depois) a partir da origem da Publicacao:
/// Produto -> OFERTA_INDIVIDUAL; Post LISTA / LandingDiaria -> SELECAO;
/// Post JORNADA/DICAS_CASA -> CONTEUDO_BLOG; Post JORNADA/JORNADA_APARTAMENTO -> NARRATIVA_PESSOAL.
enum ContentType {
  OFERTA_INDIVIDUAL
  SELECAO
  CONTEUDO_BLOG
  NARRATIVA_PESSOAL
}

/// Amarrada a um Produto, a um Post (LISTA ou JORNADA) OU a uma LandingDiaria —
/// exatamente um dos três (CHECK constraint na migration garante isso).
model Publicacao {
  id              String  @id @default(cuid())
  produtoId       String?
  postId          String?
  landingDiariaId String?
  canalId         String

  agendadaPara DateTime
  status       StatusPublicacao @default(PENDENTE)
  contentType  ContentType

  /// Texto já renderizado no agendamento — auditável e editável antes de sair.
  texto       String  @db.Text
  imagemUrl   String?
  /// Produto: linkAfiliado da loja. Lista/artigo: URL do blog. Landing: /vitrine/:slug.
  linkDestino String

  tentativas    Int       @default(0)
  idPostExterno String?
  erro          String?   @db.Text
  publicadaEm   DateTime?

  /// Insights da Graph API (regra 5) — só preenchido para FACEBOOK_PAGE, quando
  /// o post já tem idPostExterno e o job de sincronização já rodou. Nulo até lá.
  /// visualizacoes = post_impressions (Meta Business Suite chama de "Visualizações").
  visualizacoes          Int?
  visualizadoresUnicos   Int?
  engajamentos           Int?
  insightsSincronizadoEm DateTime?

  /// produtoId|postId:canalId:instante — barra duplicata mesmo com dois workers.
  chaveIdempotencia String @unique

  produto       Produto?       @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  post          Post?          @relation(fields: [postId], references: [id], onDelete: Cascade)
  landingDiaria LandingDiaria? @relation(fields: [landingDiariaId], references: [id], onDelete: Cascade)
  canal         Canal          @relation(fields: [canalId], references: [id], onDelete: Cascade)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([status, agendadaPara])
  @@index([canalId, agendadaPara])
  @@index([canalId, contentType, agendadaPara])
  @@index([contentType, publicadaEm])
  @@index([produtoId, canalId, publicadaEm])
  @@index([postId, canalId, publicadaEm])
  @@index([landingDiariaId, canalId, publicadaEm])
  @@map("publicacoes")
}

// ---------------------------------------------------------------------------
// APOIO
// ---------------------------------------------------------------------------

model Credencial {
  id       String  @id @default(cuid())
  /// "mercado_livre" | "meta" | "telegram"
  provedor String  @unique
  /// JSON cifrado com AES-256-GCM (lib/integrations/crypto.ts).
  payload  String  @db.Text
  ativo    Boolean @default(true)

  atualizadoEm DateTime @updatedAt

  @@map("credenciais")
}

model Clique {
  id        String  @id @default(cuid())
  produtoId String
  /// "lista:facebook-achadinhos" | "vitrine:slug" | "produto" — parâmetro ?o= do /go
  origem    String?
  /// Hash do IP + user agent. Nunca o IP em claro (LGPD).
  visitante String?
  referer   String?

  criadoEm DateTime @default(now())

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@index([produtoId, criadoEm])
  @@index([origem, criadoEm])
  @@map("cliques")
}

model Assinante {
  id         String    @id @default(cuid())
  email      String    @unique
  ativo      Boolean   @default(true)
  /// Descadastro em um clique, sem login.
  tokenBaixa String    @unique @default(cuid())
  criadoEm   DateTime  @default(now())
  baixaEm    DateTime?

  @@map("assinantes")
}

enum NivelLog {
  INFO
  ALERTA
  ERRO
}

/// Linha única (id fixo) com parâmetros do app editáveis pelo admin — evita
/// depender de variável de ambiente para valores que mudam com frequência.
model Configuracao {
  id String @id @default("app")

  /// Máximo de produtos importados por rodada da descoberta automática da Shopee.
  shopeeDescobertaLimiteDiario Int @default(15)
  /// Comissão mínima (%) para uma oferta da Shopee entrar na descoberta automática.
  shopeeComissaoMinimaPct      Int @default(10)

  atualizadoEm DateTime @updatedAt

  @@map("configuracoes")
}

enum ModoProjeto {
  NORMAL
  VITRINE
}

enum FaixaPreco {
  ACESSIVEL
  INTERMEDIARIO
  PREMIUM
}

enum SeloLanding {
  MAIOR_DESCONTO
  MAIS_VENDIDO
  ACHADINHO_DO_DIA
  ULTIMAS_UNIDADES
}

enum StatusLanding {
  RASCUNHO
  PUBLICADA
  FALHOU
}

/// Configuração do modo vitrine por Destino (o "projeto" do sistema).
/// Toggle por destino — ChartFM/Umbanda podem ficar em NORMAL, Achadinhos em VITRINE.
model ConfiguracaoVitrine {
  destino Destino     @id
  modo    ModoProjeto @default(NORMAL)

  /// Produto entra na curadoria com desconto ≥ este % OU marcado como destaque.
  descontoMinimoPct Int     @default(20)
  /// Faixa ACESSIVEL: preço atual até este valor (R$).
  tetoAcessivel     Decimal @default(50) @db.Decimal(12, 2)
  /// Faixa INTERMEDIARIO: acima de tetoAcessivel até este valor; acima é PREMIUM.
  tetoIntermediario Decimal @default(150) @db.Decimal(12, 2)
  /// Mínimo de itens da landing na faixa ACESSIVEL (ex.: 40).
  cotaAcessivelPct  Int     @default(40)
  quantidadeItens   Int     @default(16)
  maxPorCategoria   Int     @default(3)

  /// Convites para os grupos — não são links de afiliado.
  linkGrupoWhatsapp String?
  linkGrupoTelegram String?

  atualizadoEm DateTime @updatedAt

  @@map("configuracoes_vitrine")
}

model LandingDiaria {
  id              String        @id @default(cuid())
  destino         Destino
  /// Dia civil no fuso TZ_APP, gravado como DATE (uma landing por destino/dia).
  data            DateTime      @db.Date
  slug            String        @unique
  heroProdutoId   String?
  heroProduto     Produto?      @relation("HeroDaLanding", fields: [heroProdutoId], references: [id], onDelete: SetNull)
  headline        String?
  metaTitulo      String
  metaDescricao   String
  status          StatusLanding @default(RASCUNHO)
  /// false quando o Gemini falhou e os textos vieram do template.
  textosViaGemini Boolean       @default(false)
  geradaEm        DateTime      @default(now())

  itens       LandingProduto[]
  publicacoes Publicacao[]

  @@unique([destino, data])
  @@index([destino, status])
  @@map("landings_diarias")
}

model LandingProduto {
  id              String        @id @default(cuid())
  landingDiariaId String
  landingDiaria   LandingDiaria @relation(fields: [landingDiariaId], references: [id], onDelete: Cascade)
  produtoId       String
  produto         Produto       @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  posicao         Int
  faixaPreco      FaixaPreco
  selo            SeloLanding?
  tituloCurto     String?
  descricao       String?       @db.Text

  @@unique([landingDiariaId, produtoId])
  @@index([landingDiariaId, posicao])
  @@map("landing_produtos")
}

/// Log mínimo do que o worker fez — o suficiente para explicar um post que não saiu.
model Log {
  id       String   @id @default(cuid())
  nivel    NivelLog
  area     String
  mensagem String   @db.Text
  contexto Json?
  criadoEm DateTime @default(now())

  @@index([criadoEm])
  @@map("logs")
}
