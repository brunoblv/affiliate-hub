// Affiliate Hub v2 — schema enxuto
// Blog (CMS) + catálogo de produtos + fila de distribuição.
// Ver docs/hub/especificacao-affiliate-hub-v2.md

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Admin (NextAuth) — nomes em inglês de propósito: @auth/prisma-adapter
// resolve os models pelo nome do client gerado (prisma.user/.account/.session),
// então não pode ser traduzido para Usuario/Conta/Sessao como no restante do
// schema, sob pena de o adapter quebrar em silêncio.
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  EDITOR
  VIEWER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  passwordHash  String?
  role          UserRole  @default(EDITOR)
  emailVerified DateTime?
  image         String?

  accounts Account[]
  sessions Session[]
  posts    Post[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// ---------------------------------------------------------------------------
// CONTEÚDO — blog editável pelo CMS
// ---------------------------------------------------------------------------

enum TipoPost {
  JORNADA // editorial: "Como escolhemos o sofá"
  PRODUTO // página de um produto só
  LISTA // roundup com vários produtos
}

enum StatusPost {
  RASCUNHO
  PUBLICADO
}

model Post {
  id     String   @id @default(cuid())
  tipo   TipoPost
  titulo String
  slug   String   @unique
  resumo String?

  /// Markdown. Imagens no meio do texto via ![alt](url) e cards de produto
  /// via shortcode em linha própria: [produto:slug-do-produto]
  corpo String @db.Text

  capaId String?
  capa   Midia?  @relation("CapaDoPost", fields: [capaId], references: [id], onDelete: SetNull)

  seoTitulo     String?
  metaDescricao String?

  status      StatusPost @default(RASCUNHO)
  publicadoEm DateTime?

  /// Site/grupos pra onde este post é distribuído quando tipo = LISTA — ver
  /// enum Destino. Ignorado em JORNADA/PRODUTO (esses não entram na fila).
  destino Destino @default(MEU_NOVO_LAR)

  autorId String?
  autor   User?   @relation(fields: [autorId], references: [id], onDelete: SetNull)

  produtos    ItemDePost[]
  midias      MidiaEmPost[]
  publicacoes Publicacao[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([status, publicadoEm])
  @@index([tipo])
  @@map("posts")
}

/// Produto exibido dentro de um post (PRODUTO ou LISTA), na ordem do texto.
model ItemDePost {
  id        String  @id @default(cuid())
  postId    String
  produtoId String
  ordem     Int     @default(0)
  /// Ex.: "1. Sofá retrátil 3 lugares"
  rotulo    String?
  /// Por que esse produto, em 1-2 frases suas.
  nota      String? @db.Text

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@unique([postId, produtoId])
  @@index([postId, ordem])
  @@map("itens_de_post")
}

// ---------------------------------------------------------------------------
// MÍDIA — biblioteca de imagens do CMS
// ---------------------------------------------------------------------------

model Midia {
  id           String @id @default(cuid())
  /// URL pública servida pelo site (ex.: /midia/2026/08/sofa-abc123.webp)
  url          String @unique
  /// Caminho no disco/bucket, relativo a MEDIA_ROOT.
  caminho      String
  nomeOriginal String
  mimeType     String
  tamanhoBytes Int
  largura      Int?
  altura       Int?
  /// Texto alternativo — obrigatório para acessibilidade e SEO.
  alt          String?

  capaDe      Post[]        @relation("CapaDoPost")
  usosEmPosts MidiaEmPost[]

  criadoEm DateTime @default(now())

  @@index([criadoEm])
  @@map("midias")
}

/// Rastreia quais imagens estão embutidas no corpo de cada post.
/// Serve para avisar antes de excluir uma mídia ainda em uso.
model MidiaEmPost {
  postId  String
  midiaId String

  post  Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  midia Midia @relation(fields: [midiaId], references: [id], onDelete: Cascade)

  @@id([postId, midiaId])
  @@map("midias_em_posts")
}

// ---------------------------------------------------------------------------
// CATÁLOGO
// ---------------------------------------------------------------------------

enum Plataforma {
  MERCADO_LIVRE
  AMAZON
  SHOPEE
  TIKTOK_SHOP
}

/// Onde o produto é divulgado (site + grupos) — independente da Plataforma
/// (a loja de origem). Um produto do Mercado Livre pode ser de Umbanda, por
/// exemplo: a Plataforma é de onde ele foi comprado, o Destino é pra quem.
enum Destino {
  MEU_NOVO_LAR
  TIKTOK_SHOP
  UMBANDA
}

/// Nicho/tema do produto p/ categorização de catálogo — independente de
/// Destino (que é canal/público de divulgação, não assunto do produto).
enum Categoria {
  COZINHA
  BELEZA
  CASA_DECORACAO
  ELETRONICOS
  MODA
  UMBANDA_RELIGIAO
  PET
  OUTRA
}

model Produto {
  id         String     @id @default(cuid())
  plataforma Plataforma
  /// ID na plataforma de origem (ex.: MLB1234567890)
  idExterno  String
  slug       String     @unique
  /// Site/grupos onde é divulgado — ver enum Destino.
  destino    Destino    @default(MEU_NOVO_LAR)
  /// Nicho/tema do produto — ver enum Categoria.
  categoria  Categoria  @default(OUTRA)

  nome      String
  descricao String? @db.Text
  /// string[] — até 6 URLs de imagem vindas da API da plataforma.
  imagens   Json    @default("[]")

  precoAtual    Decimal  @db.Decimal(12, 2)
  precoOriginal Decimal? @db.Decimal(12, 2)
  moeda         String   @default("BRL")

  /// Link de afiliado colado por você. Nunca exibido direto: sempre via /go.
  linkAfiliado String
  /// Código do redirecionador rastreado: /go/:codigoCurto
  codigoCurto  String @unique

  /// Resposta íntegra da API no último sync — só para depuração.
  dadosBrutos Json?

  ativo          Boolean   @default(true)
  sincronizadoEm DateTime?

  itens       ItemDePost[]
  publicacoes Publicacao[]
  cliques     Clique[]
  precos      HistoricoPreco[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([plataforma, idExterno])
  @@index([ativo])
  @@index([destino])
  @@index([categoria])
  @@map("produtos")
}

/// Só para mostrar "de R$ X por R$ Y" com honestidade e detectar produto fora do ar.
model HistoricoPreco {
  id           String   @id @default(cuid())
  produtoId    String
  preco        Decimal  @db.Decimal(12, 2)
  registradoEm DateTime @default(now())

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@index([produtoId, registradoEm])
  @@map("historico_precos")
}

// ---------------------------------------------------------------------------
// DISTRIBUIÇÃO
// ---------------------------------------------------------------------------

enum Rede {
  FACEBOOK_PAGE
  FACEBOOK_GROUP
  INSTAGRAM
  TELEGRAM
  WHATSAPP
}

model Canal {
  id        String  @id @default(cuid())
  nome      String
  rede      Rede
  /// Site/grupos que este canal atende — ver enum Destino.
  destino   Destino @default(MEU_NOVO_LAR)
  /// page_id (Facebook page), group_id (Facebook group), ig_user_id (Instagram),
  /// chat_id (Telegram) ou JID do grupo (WhatsApp/Baileys).
  idExterno String
  ativo     Boolean @default(true)

  /// string[] no formato "HH:mm", no fuso TZ_APP. Ex.: ["09:00","13:00","19:30"]
  horarios Json @default("[]")

  /// Minutos mínimos entre duas publicações neste canal.
  intervaloMinimoMin Int @default(90)
  /// Máximo de publicações por dia neste canal.
  tetoDiario         Int @default(6)
  /// Dias antes de o mesmo produto poder repetir neste canal.
  cooldownDias       Int @default(30)

  publicacoes Publicacao[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([rede, idExterno])
  @@index([ativo])
  @@index([destino])
  @@map("canais")
}

enum StatusPublicacao {
  PENDENTE
  PUBLICANDO
  PUBLICADA
  FALHOU
  CANCELADA
}

/// Amarrada a um Produto OU a um Post (tipo LISTA) — nunca os dois, nunca
/// nenhum (CHECK constraint na migration garante isso a nível de banco).
model Publicacao {
  id        String  @id @default(cuid())
  produtoId String?
  postId    String?
  canalId   String

  agendadaPara DateTime
  status       StatusPublicacao @default(PENDENTE)

  /// Texto já renderizado no agendamento — auditável e editável antes de sair.
  texto       String  @db.Text
  imagemUrl   String?
  /// URL do post no blog (Página do Facebook/Instagram, exceto Destino UMBANDA,
  /// e sempre para Publicacao de Post/Lista) ou /go/:codigo (Telegram,
  /// WhatsApp, grupo do Facebook e Umbanda, só para Publicacao de Produto).
  linkDestino String

  tentativas    Int       @default(0)
  idPostExterno String?
  erro          String?   @db.Text
  publicadaEm   DateTime?

  /// produtoId|postId:canalId:instante — barra duplicata mesmo com dois workers.
  chaveIdempotencia String @unique

  produto Produto? @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  canal   Canal    @relation(fields: [canalId], references: [id], onDelete: Cascade)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([status, agendadaPara])
  @@index([canalId, agendadaPara])
  @@index([produtoId, canalId, publicadaEm])
  @@index([postId, canalId, publicadaEm])
  @@map("publicacoes")
}

// ---------------------------------------------------------------------------
// APOIO
// ---------------------------------------------------------------------------

model Credencial {
  id       String  @id @default(cuid())
  /// "mercado_livre" | "meta" | "telegram"
  provedor String  @unique
  /// JSON cifrado com AES-256-GCM (lib/integrations/crypto.ts).
  payload  String  @db.Text
  ativo    Boolean @default(true)

  atualizadoEm DateTime @updatedAt

  @@map("credenciais")
}

model Clique {
  id        String  @id @default(cuid())
  produtoId String
  /// "blog" | "facebook" | "telegram" | "instagram" — parâmetro ?o= do /go
  origem    String?
  /// Hash do IP + user agent. Nunca o IP em claro (LGPD).
  visitante String?
  referer   String?

  criadoEm DateTime @default(now())

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@index([produtoId, criadoEm])
  @@index([origem, criadoEm])
  @@map("cliques")
}

model Assinante {
  id         String    @id @default(cuid())
  email      String    @unique
  ativo      Boolean   @default(true)
  /// Descadastro em um clique, sem login.
  tokenBaixa String    @unique @default(cuid())
  criadoEm   DateTime  @default(now())
  baixaEm    DateTime?

  @@map("assinantes")
}

enum NivelLog {
  INFO
  ERRO
}

/// Log mínimo do que o worker fez — o suficiente para explicar um post que não saiu.
model Log {
  id       String   @id @default(cuid())
  nivel    NivelLog
  area     String
  mensagem String   @db.Text
  contexto Json?
  criadoEm DateTime @default(now())

  @@index([criadoEm])
  @@map("logs")
}
