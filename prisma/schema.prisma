// Prisma schema — Sistema de Automação de Afiliados
// Ver especificacoes-sistema-afiliados.md para o desenho completo

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Autenticação / usuários administrativos
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  EDITOR
  VIEWER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  passwordHash  String?
  role          UserRole  @default(EDITOR)
  emailVerified DateTime?
  image         String?

  accounts Account[]
  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Plataformas / canais (enums compartilhados)
// ---------------------------------------------------------------------------

enum Platform {
  SHOPEE
  TIKTOK_SHOP
  AMAZON
  ALIEXPRESS
  MAGALU
  MERCADO_LIVRE
  OUTRAS
}

enum Channel {
  FACEBOOK
  INSTAGRAM
  TIKTOK
  TELEGRAM
  WEBSITE
  BLOG
  PINTEREST
  OUTROS
}

enum EntityStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  ARCHIVED
}

// ---------------------------------------------------------------------------
// Categorias
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  parentId    String?
  active      Boolean  @default(true)

  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryToCategory")

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@map("categories")
}

// ---------------------------------------------------------------------------
// Produtos
// ---------------------------------------------------------------------------

model Product {
  id          String   @id @default(cuid())
  source      Platform
  externalId  String
  name        String
  slug        String   @unique
  description String?  @db.Text
  brand       String?
  categoryId  String?

  imageUrl   String?
  productUrl String?

  price           Decimal  @db.Decimal(12, 2)
  originalPrice   Decimal? @db.Decimal(12, 2)
  discountPercent Decimal? @db.Decimal(5, 2)

  rating      Decimal? @db.Decimal(3, 2)
  reviewCount Int?     @default(0)
  soldCount   Int?     @default(0)

  commissionPercent Decimal? @db.Decimal(5, 2)
  commissionValue   Decimal? @db.Decimal(12, 2)

  currency String @default("BRL")

  status EntityStatus @default(ACTIVE)

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  sources          ProductSource[]
  scores           ProductScore[]
  opportunities    Opportunity[]
  affiliateLinks   AffiliateLink[]
  contents         Content[]
  campaignProducts CampaignProduct[]
  priceHistory     ProductPriceHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, externalId])
  @@index([categoryId])
  @@index([status])
  @@map("products")
}

/** Histórico de preço — base para detectar quedas de preço (OpportunityType.PRICE_DROP, spec §9). */
model ProductPriceHistory {
  id        String  @id @default(cuid())
  productId String
  price     Decimal @db.Decimal(12, 2)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  recordedAt DateTime @default(now())

  @@index([productId, recordedAt])
  @@map("product_price_history")
}

model ProductSource {
  id           String    @id @default(cuid())
  productId    String
  platform     Platform
  externalId   String
  externalUrl  String?
  affiliateUrl String?
  storeName    String?
  rawData      Json?
  lastSyncedAt DateTime?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([platform, externalId])
  @@index([productId])
  @@map("product_sources")
}

// ---------------------------------------------------------------------------
// Score & Oportunidades
// ---------------------------------------------------------------------------

model ProductScore {
  id        String @id @default(cuid())
  productId String

  discountScore   Decimal @default(0) @db.Decimal(5, 2)
  ratingScore     Decimal @default(0) @db.Decimal(5, 2)
  salesScore      Decimal @default(0) @db.Decimal(5, 2)
  commissionScore Decimal @default(0) @db.Decimal(5, 2)
  priceScore      Decimal @default(0) @db.Decimal(5, 2)
  trendScore      Decimal @default(0) @db.Decimal(5, 2)
  conversionScore Decimal @default(0) @db.Decimal(5, 2)

  totalScore Decimal @db.Decimal(5, 2)

  calculatedAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([totalScore])
  @@map("product_scores")
}

enum OpportunityType {
  PRICE_DROP
  HIGH_DISCOUNT
  HIGH_SALES
  TRENDING
  HIGH_COMMISSION
  HIGH_CONVERSION
  NEW_PRODUCT
  CAMPAIGN
}

enum OpportunityStatus {
  OPEN
  IN_PROGRESS
  CONVERTED
  DISMISSED
}

model Opportunity {
  id        String            @id @default(cuid())
  productId String
  type      OpportunityType
  score     Decimal           @db.Decimal(5, 2)
  reason    String?           @db.Text
  metadata  Json?
  status    OpportunityStatus @default(OPEN)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([status])
  @@map("opportunities")
}

// ---------------------------------------------------------------------------
// Links de afiliado & tracking
// ---------------------------------------------------------------------------

model AffiliateLink {
  id        String @id @default(cuid())
  productId String

  platform Platform
  channel  Channel

  affiliateUrl String  @db.Text
  subId        String?
  shortCode    String  @unique @default(cuid())

  clicks      Int     @default(0)
  conversions Int     @default(0)
  commission  Decimal @default(0) @db.Decimal(12, 2)

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  clicksLog Click[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([shortCode])
  @@map("affiliate_links")
}

model Click {
  id              String @id @default(cuid())
  affiliateLinkId String

  ipHash    String?
  userAgent String? @db.Text
  referer   String? @db.Text

  country String?
  device  String?
  browser String?

  affiliateLink AffiliateLink @relation(fields: [affiliateLinkId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([affiliateLinkId])
  @@index([createdAt])
  @@map("clicks")
}

// ---------------------------------------------------------------------------
// Campanhas
// ---------------------------------------------------------------------------

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  FINISHED
  CANCELLED
}

model Campaign {
  id          String  @id @default(cuid())
  name        String
  description String? @db.Text

  startAt DateTime?
  endAt   DateTime?

  status CampaignStatus @default(DRAFT)

  products CampaignProduct[]
  contents Content[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("campaigns")
}

model CampaignProduct {
  id         String @id @default(cuid())
  campaignId String
  productId  String

  priority Int          @default(0)
  status   EntityStatus @default(ACTIVE)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, productId])
  @@map("campaign_products")
}

// ---------------------------------------------------------------------------
// Conteúdo
// ---------------------------------------------------------------------------

enum ContentType {
  FACEBOOK_POST
  INSTAGRAM_POST
  INSTAGRAM_STORY
  INSTAGRAM_REEL
  TIKTOK_VIDEO
  TELEGRAM_POST
  BLOG_ARTICLE
}

enum ContentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PUBLISHED
}

model Content {
  id String @id @default(cuid())

  productId  String?
  campaignId String?

  type        ContentType
  title       String?
  description String?     @db.Text
  caption     String?     @db.Text
  hashtags    String?

  imageUrl String?
  videoUrl String?

  status ContentStatus @default(DRAFT)

  product      Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  campaign     Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  publications Publication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([campaignId])
  @@map("contents")
}

model ContentTemplate {
  id       String      @id @default(cuid())
  name     String
  channel  Channel
  type     ContentType
  template String      @db.Text
  active   Boolean     @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("content_templates")
}

// ---------------------------------------------------------------------------
// Publicações
// ---------------------------------------------------------------------------

enum PublicationStatus {
  DRAFT
  QUEUED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
}

model Publication {
  id        String  @id @default(cuid())
  contentId String
  channel   Channel

  scheduledAt DateTime?
  publishedAt DateTime?

  status PublicationStatus @default(DRAFT)

  externalPostId String?

  error    String? @db.Text
  attempts Int     @default(0)

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contentId])
  @@index([status])
  @@index([scheduledAt])
  @@map("publications")
}

// ---------------------------------------------------------------------------
// Scheduler (spec §25)
// ---------------------------------------------------------------------------

/**
 * Horário recorrente de publicação configurável pelo usuário: canal,
 * horário, categoria, quantidade de posts, campanha, tipo de conteúdo,
 * score mínimo, faixa de preço e desconto mínimo.
 *
 * categoryId/campaignId são referências soltas (sem FK) para não acoplar o
 * agendamento ao ciclo de vida de Category/Campaign.
 */
model ScheduleSlot {
  id   String @id @default(cuid())
  name String

  channel Channel

  /** Horário no formato HH:mm (horário local do servidor). */
  time String

  categoryId  String?
  campaignId  String?
  contentType ContentType?

  minScore    Decimal? @db.Decimal(5, 2)
  minDiscount Decimal? @db.Decimal(5, 2)
  minPrice    Decimal? @db.Decimal(12, 2)
  maxPrice    Decimal? @db.Decimal(12, 2)

  postsPerSlot Int     @default(1)
  active       Boolean @default(true)

  lastRunAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@map("schedule_slots")
}

// ---------------------------------------------------------------------------
// Autopilot
// ---------------------------------------------------------------------------

enum AutopilotMode {
  MANUAL
  SEMI_AUTOMATIC
  AUTOMATIC
}

model AutopilotRule {
  id     String  @id @default(cuid())
  name   String
  active Boolean @default(true)

  mode    AutopilotMode @default(SEMI_AUTOMATIC)
  channel Channel       @default(FACEBOOK)

  minScore      Decimal? @db.Decimal(5, 2)
  minDiscount   Decimal? @db.Decimal(5, 2)
  minRating     Decimal? @db.Decimal(3, 2)
  minCommission Decimal? @db.Decimal(5, 2)
  minSales      Int?
  maxPrice      Decimal? @db.Decimal(12, 2)
  minPrice      Decimal? @db.Decimal(12, 2)

  allowedCategoryIds Json? // string[]
  blockedCategoryIds Json? // string[]

  maxPublicationsPerDay Int? @default(10)

  targetCampaignId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("autopilot_rules")
}

// ---------------------------------------------------------------------------
// Jobs / Logs / Configurações
// ---------------------------------------------------------------------------

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model Job {
  id       String    @id @default(cuid())
  queue    String
  name     String
  status   JobStatus @default(PENDING)
  payload  Json?
  result   Json?
  error    String?   @db.Text
  attempts Int       @default(0)

  startedAt  DateTime?
  finishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([queue])
  @@index([status])
  @@map("jobs")
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

model Log {
  id      String   @id @default(cuid())
  level   LogLevel @default(INFO)
  scope   String // e.g. PRODUCT_SYNC, CONTENT, PUBLISH, WEBHOOK
  message String   @db.Text
  meta    Json?

  createdAt DateTime @default(now())

  @@index([scope])
  @@index([level])
  @@index([createdAt])
  @@map("logs")
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ---------------------------------------------------------------------------
// Credenciais de integração (tokens criptografados por provider)
// ---------------------------------------------------------------------------

/**
 * Superset de Platform (fontes de produto) + provedores de publicação
 * (Meta/Instagram) que também guardam tokens OAuth em IntegrationCredential.
 */
enum IntegrationProvider {
  SHOPEE
  TIKTOK_SHOP
  MERCADO_LIVRE
  AMAZON
  ALIEXPRESS
  MAGALU
  META
  INSTAGRAM
  OUTRAS
}

model IntegrationCredential {
  id       String              @id @default(cuid())
  provider IntegrationProvider
  label    String?

  encryptedPayload String @db.Text // JSON criptografado com tokens/segredos

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, label])
  @@map("integration_credentials")
}
